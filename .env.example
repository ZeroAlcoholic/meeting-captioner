# Copy to .env and fill values. NEVER commit .env.
# .env is gitignored — only this example file is tracked.

# --- Online Service (services/online) ---
# OpenAI API key — server-side only. NEVER expose to browser.
# Required for P2 (Online Realtime). Not needed for P0.
OPENAI_API_KEY=

# Fastify port for online session bridge.
ONLINE_PORT=8787

# CORS allowlist for the web app dev origin.
ONLINE_CORS_ORIGIN=http://localhost:5173

# --- Offline Service (services/offline) ---
# FastAPI port for offline STT / MT bridge.
OFFLINE_PORT=8000

# --- Web App (apps/web) ---
# Public URLs the renderer talks to. Vite requires VITE_ prefix.
VITE_ONLINE_BASE_URL=http://localhost:8787
VITE_OFFLINE_BASE_URL=http://localhost:8000
