# services/online — environment template. Copy to .env and fill in.
# All values are optional except OPENAI_API_KEY (without it the service
# returns 503 on /session and the UI shows "No API Key").

# Server-side OpenAI API key. NEVER commit a real key.
OPENAI_API_KEY=

# Bind port (default 8787)
ONLINE_PORT=8787

# CORS allow-list — single origin string, must match the web dev URL
ONLINE_CORS_ORIGIN=http://localhost:5173

# Hard ceiling on the upstream client_secrets call. Above this we 504 the caller.
OPENAI_TIMEOUT_MS=10000

# Token-bucket cap on POST /session per remote IP (per minute, single-process)
SESSION_RATE_LIMIT_PER_MIN=30

# How long the browser should run a session before renewing. OpenAI caps
# Realtime translation around 30 min, so 25 min leaves headroom.
SESSION_RENEW_MS=1500000
