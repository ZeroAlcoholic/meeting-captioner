{
  "name": "meeting-audio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Meeting-grade live caption, translation, and semi-realtime summary system.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "service:start": "node scripts/service.mjs start",
    "service:status": "node scripts/service.mjs status",
    "service:stop": "node scripts/service.mjs stop",
    "test:service": "node --test scripts/managed-service.test.mjs scripts/service-child.test.mjs scripts/service-build.test.mjs scripts/service-build-retention.test.mjs",
    "dev": "concurrently -n web,online -c blue,green \"pnpm -F web dev\" \"pnpm -F online dev\"",
    "dev:full": "concurrently --kill-others --names web,online,whl,offline -c blue,green,magenta,yellow \"pnpm -F web dev\" \"pnpm -F online dev\" \"cd services/offline && uv run python run_whl.py\" \"cd services/offline && uv run uvicorn app.main:app --host 127.0.0.1 --port 8000 --reload\"",
    "build": "pnpm -r build",
    "test": "pnpm -r test && pnpm test:boundaries && pnpm test:e2e-helpers && pnpm test:workspace && pnpm check:capacity",
    "test:workspace": "node --test scripts/release-retention.test.mjs scripts/workspace-capacity.test.mjs",
    "check:capacity": "node scripts/workspace-capacity.mjs",
    "test:boundaries": "node --test tests/architecture/provider-boundaries.test.mjs",
    "test:e2e-helpers": "node --test tests/e2e/e2e-temp.test.mjs",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,css}\" \"!**/.pytest_cache/**\" \"!.cache/**\"",
    "format:check": "prettier --check --end-of-line auto \"**/*.{ts,tsx,js,json,md,css}\" \"!**/.pytest_cache/**\" \"!.cache/**\"",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.7.4",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "concurrently": "^9.0.1",
    "eslint": "^9.12.0",
    "globals": "^17.6.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.2",
    "vitest": "^2.1.2"
  }
}
