{
  "name": "@meeting-audio/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:online": "tsc -p tsconfig.online.json && tsc -p tsconfig.node.json && vite build --config vite.online.config.ts",
    "build:mobile": "tsc -p tsconfig.online.json && tsc -p tsconfig.node.json && vite build --config vite.mobile.config.ts",
    "dev:mobile": "vite --config vite.mobile.config.ts --open /mobile.html",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@meeting-audio/contracts": "workspace:*",
    "@ricky0123/vad-web": "0.0.31",
    "opencc-js": "^1.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vitest": "^2.1.2"
  }
}
